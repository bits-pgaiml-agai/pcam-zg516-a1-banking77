{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankingAssistantResponse",
  "type": "object",
  "required": ["intent", "confidence", "response", "needs_tool", "action"],
  "properties": {
    "intent": {
      "type": "string",
      "description": "Predicted BANKING77 intent label"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "response": {
      "type": "string",
      "description": "Safe customer-facing reply"
    },
    "needs_tool": {
      "type": "boolean"
    },
    "action": {
      "type": ["object", "null"],
      "properties": {
        "tool_name": { "type": "string" },
        "arguments": { "type": "object" }
      },
      "required": ["tool_name", "arguments"]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
